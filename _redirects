# Clean-URL routing for pages added outside netlify.toml (which is hash-locked by the product loop).
# Netlify processes these together with the netlify.toml [[redirects]]; first match wins, no conflicts.
/mvpalpha     /mvpalpha/index.html     200
/mvpalpha/    /mvpalpha/index.html     200
/nfl          /nfl/index.html          200
/nfl/         /nfl/index.html          200
/grok-beta    /grok-beta/index.html    200
/grok-beta/   /grok-beta/index.html    200
/api/grok-beta-picks  /.netlify/functions/grok-beta-get-picks  200
/api/grok-beta-run    /.netlify/functions/grok-beta-run        200
/api/grok-beta-status /.netlify/functions/grok-beta-status     200
