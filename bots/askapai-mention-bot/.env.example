# ─────────────────────────────────────────────────────────────
# @AskApai mention-reply bot — environment
# Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── X API v2 — OAuth 1.0a user context for the @AskApai account ──
# From developer.x.com → your App → Keys and tokens.
# The Access Token/Secret MUST be for @AskApai and have Read+Write.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Aliases also accepted: X_API_KEY / X_API_SECRET / X_ACCESS_TOKEN / X_ACCESS_SECRET

# Optional: skip the GET /2/users/me lookup by hardcoding the numeric id.
ASKAPAI_USER_ID=
ASKAPAI_HANDLE=AskApai

# ── Apai chat backend (the real brain) ──
# The bot relays each mentioned post to Apai's EXISTING chat endpoint — the same
# one behind the daily dose + web chat — as if a user typed
# "rate this post for authenticity and manipulation", and posts her reply.
# Point this at that endpoint. Leave blank to use a chat-style stub (offline).
APAI_CHAT_URL=
APAI_CHAT_KEY=
# Match Apai's request/response contract without code changes:
#   APAI_REQUEST_FIELD = the JSON key the endpoint reads the user message from
#   APAI_REPLY_FIELDS  = comma-list of keys to read her reply from (first match wins)
APAI_REQUEST_FIELD=message
APAI_REPLY_FIELDS=reply,message,text,response,answer
APAI_TIMEOUT_MS=25000
# Append "Follow @AskApai for daily truth scores." when her reply leaves room.
APAI_APPEND_CTA=true
ASKAPAI_ANALYZE_BASE=https://askapai.com/analyze

# ── Polling / pagination ──
POLL_INTERVAL_MS=90000
MENTIONS_MAX_RESULTS=25
MENTIONS_MAX_PAGES=2
REPLY_DELAY_MS=3000

# ── Cost model (tune to your X tier's real per-call price) ──
COST_PER_READ=0.005
COST_PER_REPLY=0.20

# ── Safety caps (hard stops) ──
MAX_REPLIES_PER_DAY=200
MAX_DAILY_SPEND_USD=50

# ── Charity module ──
CHARITY_ENABLED=false
CHARITY_HOUR_UTC=15

# ── Retry policy ──
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=2000

# ── Misc ──
# DRY_RUN=true scores + logs but never posts to X. Great for first boot.
DRY_RUN=true
LOG_LEVEL=info
# BOT_DATA_DIR=/var/lib/askapai-bot   # where state.json + usage.json live
